# Copie para .env se precisar mudar algo. Sem .env o app usa o proxy do Vite.

# Alvo do proxy de desenvolvimento (onde a API está rodando)
VITE_PROXY_TARGET=http://localhost:3001

# URL base da API em produção, quando o front é servido por outro domínio.
# Em desenvolvimento deixe vazio para usar o proxy ("/api").
VITE_API_URL=
