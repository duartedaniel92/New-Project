{
  "name": "@comissoes-vendedores/backend",
  "version": "1.1.0",
  "description": "API da plataforma de controle de comissões de vendedores",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch server.js",
