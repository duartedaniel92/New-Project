# Copie para .env e ajuste o que precisar. Todos os valores têm padrão seguro.

# Porta em que a API escuta
PORT=3001

# development | production | test
NODE_ENV=development

# Origens liberadas no CORS, separadas por vírgula.
# Vazio libera qualquer origem — use só em desenvolvimento.
# Ex.: CORS_ORIGIN=https://painel.minhaloja.com.br
CORS_ORIGIN=

# Margem bruta estimada usada no card de lucro líquido (0 a 1)
MARGEM_ESTIMADA=0.55

# Dias úteis considerados em um mês comercial
DIAS_UTEIS_NO_MES=22

# Teto de eventos por página na auditoria
LIMITE_AUDITORIA=100
